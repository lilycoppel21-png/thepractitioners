---
/*
  Writing page  (lives at  /writing  )
  ------------------------------------
  Lists every original article (the ones marked original: true in
  src/data/issues.ts), newest first, plus a link to the Substack.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../config";
import { issues } from "../data/issues";

const originals = issues
  .filter((i) => i.original)
  .sort((a, b) => b.date.localeCompare(a.date));

const fmt = (iso: string) =>
  new Date(iso + "T00:00:00").toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });

const pageFor = (i: { slug?: string; href?: string }) =>
  i.slug ? `/writing/${i.slug}` : i.href ?? site.substackUrl;
---

<BaseLayout title="Writing — The Practitioners">
  <section class="mx-auto max-w-2xl px-6 pt-16 pb-8 md:pt-24">
    <p class="dateline">From the archive —</p>
    <h1 class="page-title mt-4">Writing</h1>

    <p class="lead mt-6">
      The Practitioners is published weekly on Substack.
    </p>

    <p class="mt-4 text-muted">
      That's where every issue lives, and where you can read the archive and subscribe
      to get new pieces by email.
    </p>

    <div class="mt-8">
      <a
        href={site.substackUrl}
        class="inline-block rounded-md bg-blue px-6 py-3 font-medium text-white transition-colors hover:bg-navy"
      >
        Read every issue on Substack
      </a>
    </div>

    <!-- Every original article, newest first. -->
    <div class="mt-16 border-t border-navy/10">
      {originals.map((issue) => (
        <article class="border-b border-navy/10 py-8">
          <p class="dateline text-[0.7rem]">{issue.section} —</p>
          <h2 class="mt-2">
            <a
              href={pageFor(issue)}
              class="font-display text-2xl font-medium leading-snug text-navy transition-colors hover:text-blue"
            >
              {issue.title}
            </a>
          </h2>
          <p class="mt-2 text-base leading-relaxed text-muted">{issue.excerpt}</p>
          <p class="mt-3 text-xs text-muted">{fmt(issue.date)}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
