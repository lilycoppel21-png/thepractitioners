---
/*
  About page  (lives at  /about  )
  --------------------------------
  Edit the paragraphs below freely. Each <p> is one paragraph.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About — The Practitioners">
  <article class="mx-auto max-w-2xl px-6 pt-16 pb-8 md:pt-24">
    <p class="dateline">Our mission —</p>
    <h1 class="page-title mt-4">About</h1>

    <div class="mt-8 space-y-6 leading-relaxed text-ink">
      <p>
        The Practitioners is a publication about AI in the social impact sector. Our
        goal is to help nonprofits get more out of these tools, so they can do more
        with limited resources and reach more of the people they serve.
      </p>

      <p>
        Most nonprofits are already using AI, but very few have seen it meaningfully
        change how they work. We interview the ones that have, along with the people
        building the tools, to share what they learned in a way others can apply.
      </p>

      <p>
        The Practitioners is supported by Sky’s the Limit, a nonprofit accelerator for
        underserved entrepreneurs.
      </p>
    </div>
  </article>
</BaseLayout>
